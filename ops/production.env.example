# Docker Compose (guardar como /var/www/crm/.env, nunca versionar valores reales)
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=generar-un-secreto-url-safe
POSTGRES_DB=crm_db
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
REDIS_PASSWORD=generar-un-secreto-url-safe

# Backend (/var/www/crm/backend/.env)
DATABASE_URL=postgresql://crm_user:secreto@127.0.0.1:55432/crm_db
DIRECT_URL=postgresql://crm_user:secreto@127.0.0.1:55432/crm_db
REDIS_URL=redis://:secreto-url-safe@127.0.0.1:56379
JWT_SECRET=generar-un-secreto-de-al-menos-32-caracteres
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
FRONTEND_URL=https://romez.consultoriadigital.io
APP_TIMEZONE=America/Asuncion
DEFAULT_CURRENCY=PYG
GLOBAL_RATE_LIMIT_MAX=1500
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_LEGACY_CHANNELS=false
UPLOAD_MAX_BYTES=10485760
CLIENT_DOCUMENTS_DIR=.data/client-documents
WHATSAPP_AUTH_DIR=.data/whatsapp-auth
WHATSAPP_MEDIA_DIR=.data/whatsapp-media

# Frontend (solo durante build)
NEXT_PUBLIC_API_URL=https://romez.consultoriadigital.io/api/v1
ENABLE_LEGACY_CHANNELS=false

# Bootstrap inicial; cargar solo en el proceso que ejecuta el comando.
ROMEZ_OWNER_EMAIL=
ROMEZ_OWNER_PASSWORD=
ROMEZ_OWNER_FIRST_NAME=
ROMEZ_OWNER_LAST_NAME=
