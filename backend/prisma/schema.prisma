generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTING
  PAIRING
  CONNECTED
  ERROR
}

enum ClientPersonType {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ChecklistPeriodicity {
  MONTHLY
  QUARTERLY
  YEARLY
  ON_DEMAND
}

enum ChecklistStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ReceivableStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum RecurringChargeFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum TicketStatus {
  NEW
  OPEN
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InternalConversationType {
  GENERAL
  DIRECT
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 WorkspaceUser[]
  contacts              Contact[]
  pipelines             Pipeline[]
  deals                 Deal[]
  companies             Company[]
  activities            Activity[]
  notes                 Note[]
  webhooks              WebhookEndpoint[]
  apiKeys               ApiKey[]
  eventLogs             EventLog[]
  channelConnections    ChannelConnection[]
  contactIdentities     ContactIdentity[]
  conversations         Conversation[]
  messages              Message[]
  whatsappSessions      WhatsAppSession[]
  whatsappChats         WhatsAppChat[]
  whatsappMessages      WhatsAppMessage[]
  stockCategories       StockCategory[]
  stockProducts         StockProduct[]
  stockMovements        StockMovement[]
  stockCashTransactions StockCashTransaction[]
  clientAssignments     ClientAssignment[]
  checklistTemplates    ChecklistTemplate[]
  clientChecklists      ClientChecklist[]
  recurringCharges      RecurringCharge[]
  receivables           Receivable[]
  payments              Payment[]
  clientDocuments       ClientDocument[]
  tickets               Ticket[]
  ticketComments        TicketComment[]
  ticketEvents          TicketEvent[]
  internalConversations InternalConversation[]
  internalChatMessages  InternalChatMessage[]
  sales                 Sale[]
  saleItems             SaleItem[]

  @@map("workspaces")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String?
  avatar           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  workspaces               WorkspaceUser[]
  ownedContacts            Contact[]             @relation("ContactOwner")
  ownedDeals               Deal[]                @relation("DealOwner")
  activities               Activity[]
  notes                    Note[]
  stockMovements           StockMovement[]
  assignedWhatsAppChats    WhatsAppChat[]        @relation("WhatsAppChatAssignee")
  ownedCompanies           Company[]             @relation("CompanyOwner")
  clientAssignments        ClientAssignment[]
  assignedClientChecklists ClientChecklist[]     @relation("ClientChecklistAssignee")
  completedChecklistItems  ClientChecklistItem[] @relation("ClientChecklistItemCompletedBy")
  createdReceivables       Receivable[]          @relation("ReceivableCreatedBy")
  createdPayments          Payment[]             @relation("PaymentCreatedBy")
  uploadedClientDocuments  ClientDocument[]      @relation("ClientDocumentUploadedBy")
  assignedTickets          Ticket[]              @relation("TicketAssignee")
  ticketComments           TicketComment[]       @relation("TicketCommentAuthor")
  ticketEvents             TicketEvent[]         @relation("TicketEventActor")
  internalChatParticipants InternalConversationParticipant[]
  internalChatMessages     InternalChatMessage[]
  createdSales             Sale[]                @relation("SaleCreatedBy")

  @@map("users")
}

model WorkspaceUser {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_users")
}

model InternalConversation {
  id            String                   @id @default(cuid())
  workspaceId   String
  type          InternalConversationType
  key           String
  title         String?
  lastMessageAt DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  workspace    Workspace                         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  participants InternalConversationParticipant[]
  messages     InternalChatMessage[]

  @@unique([workspaceId, key])
  @@index([workspaceId, type, lastMessageAt])
  @@map("internal_conversations")
}

model InternalConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
  @@map("internal_conversation_participants")
}

model InternalChatMessage {
  id             String   @id @default(cuid())
  workspaceId    String
  conversationId String
  senderId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                 @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([workspaceId, conversationId, createdAt])
  @@map("internal_chat_messages")
}

model Contact {
  id              String    @id @default(cuid())
  workspaceId     String
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  avatar          String?
  status          String    @default("LEAD")
  source          String    @default("MANUAL")
  score           Int       @default(0)
  tags            String[]
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           User?     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  channels        Json      @default("[]")
  customData      Json      @default("{}")
  isArchived      Boolean   @default(false)
  mergedInto      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastContactedAt DateTime?

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals         DealContact[]
  activities    Activity[]
  notes         Note[]
  identities    ContactIdentity[]
  conversations Conversation[]
  messages      Message[]
  whatsappChats WhatsAppChat[]
  tickets       Ticket[]

  @@index([workspaceId])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@index([workspaceId, status])
  @@map("contacts")
}

model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    Stage[]
  deals     Deal[]

  @@index([workspaceId])
  @@map("pipelines")
}

model Stage {
  id              String  @id @default(cuid())
  pipelineId      String
  name            String
  position        Int
  color           String  @default("#6366f1")
  probability     Int? // ← agregar: probabilidad por defecto
  isWon           Boolean @default(false)
  isLost          Boolean @default(false)
  rottenAfterDays Int? // ← agregar: días para marcar como podrido

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, position])
  @@map("stages")
}

model Deal {
  id                String    @id @default(cuid())
  workspaceId       String
  leadNumber        String    @db.VarChar(8)
  title             String
  value             Decimal?  @db.Decimal(15, 2)
  currency          String    @default("PYG")
  probability       Int?
  pipelineId        String
  stageId           String
  position          Int       @default(0)
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId           String?
  owner             User?     @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  status            String    @default("OPEN")
  expectedCloseDate DateTime?
  isArchived        Boolean   @default(false)
  stageEnteredAt    DateTime  @default(now())
  closedAt          DateTime?
  closedReason      String?
  customData        Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id])
  stage      Stage         @relation(fields: [stageId], references: [id])
  contacts   DealContact[]
  activities Activity[]
  notes      Note[]

  @@unique([workspaceId, leadNumber])
  @@index([workspaceId])
  @@index([workspaceId, stageId])
  @@index([workspaceId, status])
  @@map("deals")
}

model DealContact {
  dealId    String
  contactId String
  role      String?

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([dealId, contactId])
  @@map("deal_contacts")
}

model Activity {
  id          String   @id @default(cuid())
  workspaceId String
  type        String
  entityType  String
  entityId    String
  contactId   String?
  dealId      String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  source      String?
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id])
  deal      Deal?     @relation(fields: [dealId], references: [id])

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, createdAt])
  @@map("activities")
}

model Note {
  id          String   @id @default(cuid())
  workspaceId String
  content     String
  entityType  String
  entityId    String
  contactId   String?
  dealId      String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id])
  deal      Deal?     @relation(fields: [dealId], references: [id])

  @@index([workspaceId, entityType, entityId])
  @@map("notes")
}

model WhatsAppSession {
  id                  String                   @id @default(cuid())
  workspaceId         String                   @unique
  status              WhatsAppConnectionStatus @default(DISCONNECTED)
  phoneNumber         String?
  phoneJid            String?
  pushName            String?
  pairingCode         String?
  pairingCodeIssuedAt DateTime?
  qrCode              String?
  lastConnectedAt     DateTime?
  lastDisconnectedAt  DateTime?
  lastDisconnectCode  Int?
  lastError           String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chats     WhatsAppChat[]
  messages  WhatsAppMessage[]

  @@map("whatsapp_sessions")
}

model WhatsAppChat {
  id                 String    @id @default(cuid())
  workspaceId        String
  sessionId          String
  jid                String
  lidJid             String?
  displayName        String?
  phoneNumber        String?
  phoneNumberSource  String?
  isGroup            Boolean   @default(false)
  unreadCount        Int       @default(0)
  archived           Boolean   @default(false)
  pinned             Boolean   @default(false)
  mutedUntil         DateTime?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  lastMessageFromMe  Boolean?
  contactId          String?
  assignedToUserId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session    WhatsAppSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contact    Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedTo User?             @relation("WhatsAppChatAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages   WhatsAppMessage[]
  tickets    Ticket[]

  @@unique([workspaceId, jid])
  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, contactId])
  @@index([workspaceId, assignedToUserId])
  @@map("whatsapp_chats")
}

model WhatsAppMessage {
  id                   String   @id @default(cuid())
  workspaceId          String
  sessionId            String
  chatId               String
  remoteJid            String
  messageId            String
  fromMe               Boolean  @default(false)
  participant          String?
  pushName             String?
  messageType          String   @default("unknown")
  text                 String?
  status               String?
  mediaPath            String?
  mediaMimeType        String?
  mediaFileName        String?
  mediaSizeBytes       Int?
  mediaDurationSeconds Int?
  quotedMessageId      String?
  quotedText           String?
  quotedMessageType    String?
  ticketId             String?
  sentAt               DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   WhatsAppSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chat      WhatsAppChat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  ticket    Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, remoteJid, messageId])
  @@index([workspaceId, chatId, sentAt])
  @@index([workspaceId, remoteJid, sentAt])
  @@index([workspaceId, ticketId, sentAt])
  @@map("whatsapp_messages")
}

model WebhookEndpoint {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String
  url             String
  secret          String?
  events          String[]
  isActive        Boolean   @default(true)
  successCount    Int       @default(0)
  failureCount    Int       @default(0)
  lastTriggeredAt DateTime?
  lastStatusCode  Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("webhook_endpoints")
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model EventLog {
  id          String   @id @default(cuid())
  workspaceId String
  event       String
  payload     Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, event])
  @@index([workspaceId, createdAt])
  @@map("event_logs")
}

model ChannelConnection {
  id                   String    @id @default(cuid())
  workspaceId          String
  provider             String
  channel              String
  name                 String
  status               String    @default("disconnected")
  externalAccountId    String
  externalAccountLabel String?
  credentials          Json      @default("{}")
  settings             Json      @default("{}")
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, channel, externalAccountId])
  @@index([workspaceId, channel])
  @@map("channel_connections")
}

model ContactIdentity {
  id                  String   @id @default(cuid())
  workspaceId         String
  contactId           String
  provider            String
  channel             String
  externalUserId      String
  externalUsername    String?
  externalDisplayName String?
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, channel, externalUserId])
  @@index([contactId])
  @@map("contact_identities")
}

model Conversation {
  id               String    @id @default(cuid())
  workspaceId      String
  connectionId     String
  contactId        String
  provider         String
  channel          String
  externalThreadId String?
  externalUserId   String?
  status           String    @default("open")
  inboxState       String    @default("active")
  unreadCount      Int       @default(0)
  lastInboundAt    DateTime?
  lastOutboundAt   DateTime?
  lastMessageAt    DateTime?
  assignedToUserId String?
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contact    Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@unique([connectionId, contactId])
  @@unique([workspaceId, channel, contactId])
  @@index([workspaceId, channel, lastMessageAt])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id                String    @id @default(cuid())
  workspaceId       String
  conversationId    String
  contactId         String?
  provider          String
  channel           String
  direction         String
  type              String    @default("text")
  status            String    @default("pending")
  providerMessageId String?   @unique
  providerReplyToId String?
  text              String?
  rawPayload        Json?
  metadata          Json      @default("{}")
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]
  deliveries   MessageDelivery[]

  @@index([conversationId, createdAt])
  @@index([workspaceId, channel, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id              String   @id @default(cuid())
  messageId       String
  type            String
  mimeType        String?
  url             String?
  externalAssetId String?
  fileName        String?
  sizeBytes       Int?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model MessageDelivery {
  id                String    @id @default(cuid())
  messageId         String
  providerMessageId String?
  providerStatus    String
  providerTimestamp DateTime?
  errorCode         String?
  errorMessage      String?
  rawPayload        Json?
  createdAt         DateTime  @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@index([providerMessageId])
  @@map("message_deliveries")
}

model StockCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products  StockProduct[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("stock_categories")
}

model StockProduct {
  id            String   @id @default(cuid())
  workspaceId   String
  categoryId    String?
  name          String
  description   String   @default("")
  sku           String?
  price         Decimal  @default(0) @db.Decimal(12, 2)
  cost          Decimal? @db.Decimal(12, 2)
  image         String?
  images        String[]
  featured      Boolean  @default(false)
  stockQuantity Int      @default(0)
  minStock      Int      @default(3)
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  StockCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements StockMovement[]

  @@unique([workspaceId, sku])
  @@index([workspaceId])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, isArchived])
  @@map("stock_products")
}

model StockMovement {
  id          String   @id @default(cuid())
  workspaceId String
  productId   String
  type        String
  quantity    Int
  reason      String
  note        String?
  batchCode   String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   StockProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, productId])
  @@map("stock_movements")
}

model StockCashTransaction {
  id            String   @id @default(cuid())
  workspaceId   String
  type          String
  category      String
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String?
  reference     String?
  note          String?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@map("stock_cash_transactions")
}

model Company {
  id             String           @id @default(cuid())
  workspaceId    String
  name           String
  personType     ClientPersonType @default(LEGAL_ENTITY)
  ruc            String?
  dv             String?
  legalName      String?
  tradeName      String?
  activity       String?
  taxObligations String[]         @default([])
  address        String?
  city           String?
  department     String?
  country        String           @default("Paraguay")
  status         ClientStatus     @default(ACTIVE)
  ownerId        String?
  email          String?
  phone          String?
  website        String?
  logo           String?
  tags           String[]         @default([])
  customData     Json             @default("{}")
  isArchived     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner            User?              @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts         Contact[]
  deals            Deal[]
  assignments      ClientAssignment[]
  checklists       ClientChecklist[]
  recurringCharges RecurringCharge[]
  receivables      Receivable[]
  payments         Payment[]
  documents        ClientDocument[]
  tickets          Ticket[]
  sales            Sale[]

  @@unique([workspaceId, ruc])
  @@index([workspaceId])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, status])
  @@map("companies")
}

model ClientAssignment {
  id          String   @id @default(cuid())
  workspaceId String
  companyId   String
  userId      String
  area        String   @default("GENERAL")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, area])
  @@index([workspaceId, userId])
  @@index([workspaceId, companyId])
  @@map("client_assignments")
}

model ChecklistTemplate {
  id          String               @id @default(cuid())
  workspaceId String
  name        String
  description String?
  periodicity ChecklistPeriodicity @default(MONTHLY)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  workspace  Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items      ChecklistTemplateItem[]
  checklists ClientChecklist[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id          String   @id @default(cuid())
  templateId  String
  title       String
  description String?
  position    Int
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template       ChecklistTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  checklistItems ClientChecklistItem[]

  @@unique([templateId, position])
  @@map("checklist_template_items")
}

model ClientChecklist {
  id               String          @id @default(cuid())
  workspaceId      String
  companyId        String
  templateId       String
  assignedToUserId String?
  periodKey        String
  status           ChecklistStatus @default(PENDING)
  dueDate          DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template   ChecklistTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  assignedTo User?                 @relation("ClientChecklistAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  items      ClientChecklistItem[]

  @@unique([companyId, templateId, periodKey])
  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, assignedToUserId])
  @@map("client_checklists")
}

model ClientChecklistItem {
  id                String    @id @default(cuid())
  checklistId       String
  templateItemId    String?
  title             String
  description       String?
  position          Int
  isRequired        Boolean   @default(true)
  isCompleted       Boolean   @default(false)
  completedAt       DateTime?
  completedByUserId String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  checklist    ClientChecklist        @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  templateItem ChecklistTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  completedBy  User?                  @relation("ClientChecklistItemCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@unique([checklistId, position])
  @@index([checklistId, isCompleted])
  @@map("client_checklist_items")
}

model RecurringCharge {
  id          String                   @id @default(cuid())
  workspaceId String
  companyId   String
  name        String
  description String?
  amount      Decimal                  @db.Decimal(18, 2)
  currency    String                   @default("PYG")
  frequency   RecurringChargeFrequency @default(MONTHLY)
  dayOfMonth  Int                      @default(1)
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  receivables Receivable[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, companyId])
  @@map("recurring_charges")
}

model Receivable {
  id                String           @id @default(cuid())
  workspaceId       String
  companyId         String
  recurringChargeId String?
  externalKey       String?
  description       String
  periodKey         String?
  amount            Decimal          @db.Decimal(18, 2)
  paidAmount        Decimal          @default(0) @db.Decimal(18, 2)
  currency          String           @default("PYG")
  dueDate           DateTime
  status            ReceivableStatus @default(PENDING)
  reference         String?
  createdByUserId   String?
  voidedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recurringCharge RecurringCharge?    @relation(fields: [recurringChargeId], references: [id], onDelete: SetNull)
  createdBy       User?               @relation("ReceivableCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  allocations     PaymentAllocation[]

  @@unique([recurringChargeId, periodKey])
  @@unique([workspaceId, externalKey])
  @@index([workspaceId, companyId, dueDate])
  @@index([workspaceId, status, dueDate])
  @@map("receivables")
}

model Payment {
  id              String    @id @default(cuid())
  workspaceId     String
  companyId       String
  externalKey     String?
  amount          Decimal   @db.Decimal(18, 2)
  currency        String    @default("PYG")
  paidAt          DateTime  @default(now())
  method          String?
  reference       String?
  notes           String?
  createdByUserId String?
  voidedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?               @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]

  @@index([workspaceId, companyId, paidAt])
  @@index([workspaceId, paidAt])
  @@unique([workspaceId, externalKey])
  @@map("payments")
}

model PaymentAllocation {
  id           String   @id @default(cuid())
  paymentId    String
  receivableId String
  amount       Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())

  payment    Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Restrict)

  @@unique([paymentId, receivableId])
  @@index([receivableId])
  @@map("payment_allocations")
}

model ClientDocument {
  id               String   @id @default(cuid())
  workspaceId      String
  companyId        String
  uploadedByUserId String?
  name             String
  storageKey       String
  mimeType         String?
  sizeBytes        Int?
  category         String?
  createdAt        DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("ClientDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, storageKey])
  @@index([workspaceId, companyId, createdAt])
  @@map("client_documents")
}

model Sale {
  id              String     @id @default(cuid())
  workspaceId     String
  companyId       String
  number          Int
  status          SaleStatus @default(DRAFT)
  soldAt          DateTime
  currency        String     @default("PYG")
  subtotal        Decimal    @default(0) @db.Decimal(18, 2)
  discount        Decimal    @default(0) @db.Decimal(18, 2)
  taxAmount       Decimal    @default(0) @db.Decimal(18, 2)
  total           Decimal    @default(0) @db.Decimal(18, 2)
  reference       String?
  notes           String?
  createdByUserId String?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?      @relation("SaleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items     SaleItem[]

  @@unique([workspaceId, number])
  @@index([workspaceId, soldAt])
  @@index([workspaceId, companyId, soldAt])
  @@index([workspaceId, status, soldAt])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(cuid())
  workspaceId String
  saleId      String
  description String
  quantity    Decimal  @default(1) @db.Decimal(18, 3)
  unitPrice   Decimal  @default(0) @db.Decimal(18, 2)
  total       Decimal  @default(0) @db.Decimal(18, 2)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId, position])
  @@map("sale_items")
}

model Ticket {
  id               String         @id @default(cuid())
  workspaceId      String
  number           Int
  subject          String?
  status           TicketStatus   @default(NEW)
  priority         TicketPriority @default(NORMAL)
  category         String?
  source           String         @default("WHATSAPP")
  activeKey        String?        @unique
  companyId        String?
  contactId        String?
  whatsappChatId   String?
  assignedToUserId String?
  openedAt         DateTime       @default(now())
  lastMessageAt    DateTime       @default(now())
  firstResponseAt  DateTime?
  dueAt            DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company      Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact      Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  whatsappChat WhatsAppChat?     @relation(fields: [whatsappChatId], references: [id], onDelete: SetNull)
  assignedTo   User?             @relation("TicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages     WhatsAppMessage[]
  comments     TicketComment[]
  events       TicketEvent[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, assignedToUserId, status])
  @@index([workspaceId, whatsappChatId, createdAt])
  @@map("tickets")
}

model TicketComment {
  id           String   @id @default(cuid())
  workspaceId  String
  ticketId     String
  authorUserId String?
  body         String
  internal     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User?     @relation("TicketCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketEvent {
  id          String   @id @default(cuid())
  workspaceId String
  ticketId    String
  actorUserId String?
  type        String
  fromValue   String?
  toValue     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor     User?     @relation("TicketEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, ticketId, createdAt])
  @@map("ticket_events")
}
