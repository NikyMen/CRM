# Vicar Inmobiliaria: marca y región. Sin secretos. Ver docs/marca.md.
# Se copian a mano a backend/.env y frontend/.env (ver README.md de esta carpeta).
#
# Los colores hex van ENTRE COMILLAS: sin comillas, dotenv toma "#..." como comentario,
# el valor queda vacío y la instancia vuelve en silencio a los colores de ROMEZ.

# ─── Backend (backend/.env, se lee al arrancar) ──────────────────
# Hoy APP_TIMEZONE y DEFAULT_CURRENCY no los lee ningún módulo (quedan para la fase 2).
APP_TIMEZONE=America/Argentina/Cordoba
DEFAULT_CURRENCY=ARS
BRAND_NAME=Gestión Vicar
BRAND_SHORT_NAME=Vicar
BRAND_TAGLINE=Inmobiliaria
BRAND_SLUG=vicar
BRAND_PDF_LOGO=vicar-logo
BRAND_PDF_PRIMARY_COLOR="#021c48"
BRAND_PDF_ACCENT_COLOR="#d7020e"

# ─── Frontend (frontend/.env, se fija en next build) ─────────────
NEXT_PUBLIC_BRAND_NAME=Gestión Vicar
NEXT_PUBLIC_BRAND_SHORT_NAME=Vicar
NEXT_PUBLIC_BRAND_LEGAL_NAME=Vicar Inmobiliaria
NEXT_PUBLIC_BRAND_TAGLINE=Inmobiliaria
NEXT_PUBLIC_BRAND_SLUG=vicar
NEXT_PUBLIC_BRAND_DESCRIPTION=Consultas, propiedades y atención de Vicar Inmobiliaria.
NEXT_PUBLIC_BRAND_LOGO=/brand/vicar-light.png
NEXT_PUBLIC_BRAND_LOGO_ON_DARK=/brand/vicar-dark.png
NEXT_PUBLIC_BRAND_FAVICON=/brand/vicar-favicon.png
NEXT_PUBLIC_BRAND_EMAIL_PLACEHOLDER=nombre@empresa.com.ar
# Azul marino del logo para botones y sidebar. El acento queda en azul (no en el rojo del logo):
# en la app el rojo ya significa error, vencido o "no concretado".
NEXT_PUBLIC_BRAND_COLOR_NAVY="#021c48"
NEXT_PUBLIC_BRAND_COLOR_NAVY_DEEP="#071638"
NEXT_PUBLIC_BRAND_COLOR_BLUE="#1d4f9e"
NEXT_PUBLIC_BRAND_COLOR_BLUE_HOVER="#163f80"
NEXT_PUBLIC_BRAND_COLOR_PAPER="#eaf0fa"
NEXT_PUBLIC_BRAND_COLOR_BLUE_DARK="#8fb4f0"
NEXT_PUBLIC_BRAND_COLOR_BLUE_HOVER_DARK="#b3ccf5"
NEXT_PUBLIC_BRAND_COLOR_PAPER_DARK="#8fb4f02e"

# Menú del usuario: entradas ocultas (Configuración sigue en /settings). Ver frontend/lib/instance.ts.
NEXT_PUBLIC_USER_MENU_HIDE=notifications,settings
