# Vicar en https://vicar.consultoriadigital.io. Plantilla: nunca versionar valores reales.
# VPS compartido 72.60.15.125 (alias ssh `farmacia`): puertos, procesos, usuario y base propios.
#   backend 172.18.0.1:3830 · frontend 172.18.0.1:3831 · PostgreSQL 127.0.0.1:55434 · Redis 127.0.0.1:56381

# ─── Docker Compose (/var/www/crm-vicar/.env, root 0600) ─────────
POSTGRES_USER=vicar_user
POSTGRES_PASSWORD=generar-un-secreto-url-safe
POSTGRES_DB=vicar_db
POSTGRES_HOST_PORT=55434
REDIS_HOST_PORT=56381
REDIS_PASSWORD=generar-un-secreto-url-safe

# ─── Backend (/var/www/crm-vicar/backend/.env, vicar 0600) ──────
DATABASE_URL=postgresql://vicar_user:secreto@127.0.0.1:55434/vicar_db
DIRECT_URL=postgresql://vicar_user:secreto@127.0.0.1:55434/vicar_db
REDIS_URL=redis://:secreto-url-safe@127.0.0.1:56381
JWT_SECRET=generar-al-menos-48-bytes-al-azar
NODE_ENV=production
# 172.18.0.1 es el gateway de la red de Traefik: Traefik llega, Internet no.
PORT=3830
HOST=172.18.0.1
# CORS compara el origen exacto: sin barra final.
FRONTEND_URL=https://vicar.consultoriadigital.io
# URL pública de la API: Meta descarga de acá la imagen al publicar en Instagram.
PUBLIC_API_URL=https://vicar.consultoriadigital.io
GLOBAL_RATE_LIMIT_MAX=1500
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_LEGACY_CHANNELS=true
UPLOAD_MAX_BYTES=10485760
CLIENT_DOCUMENTS_DIR=.data/client-documents
WHATSAPP_AUTH_DIR=.data/whatsapp-auth
WHATSAPP_MEDIA_DIR=.data/whatsapp-media
# No incluir las META_* vacías: frenan el arranque.
# Más la sección de backend de deploy/clients/vicar/brand.env (colores entre comillas).

# ─── Frontend (/var/www/crm-vicar/frontend/.env, se fija en next build) ───
NEXT_PUBLIC_API_URL=https://vicar.consultoriadigital.io/api/v1
ENABLE_LEGACY_CHANNELS=true
# Más la sección de frontend de deploy/clients/vicar/brand.env (colores entre comillas).
