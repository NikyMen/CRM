# Wolves Indumentaria: marca y región. Sin secretos. Ver docs/marca.md.
# Se copian a mano a backend/.env y frontend/.env (ver README.md de esta carpeta).
#
# Los colores hex van ENTRE COMILLAS: sin comillas, dotenv toma "#..." como comentario,
# el valor queda vacío y la instancia vuelve en silencio a los colores de ROMEZ.

# ─── Backend (backend/.env, se lee al arrancar) ──────────────────
# Hoy APP_TIMEZONE y DEFAULT_CURRENCY no los lee ningún módulo (quedan para la fase 2).
APP_TIMEZONE=America/Argentina/Cordoba
DEFAULT_CURRENCY=ARS
BRAND_NAME=Gestión Wolves
BRAND_SHORT_NAME=Wolves
BRAND_TAGLINE=Indumentaria deportiva y urbana
BRAND_SLUG=wolves
BRAND_PDF_LOGO=wolves-logo
BRAND_PDF_PRIMARY_COLOR="#111111"
BRAND_PDF_ACCENT_COLOR="#555555"

# ─── Frontend (frontend/.env, se fija en next build) ─────────────
NEXT_PUBLIC_BRAND_NAME=Gestión Wolves
NEXT_PUBLIC_BRAND_SHORT_NAME=Wolves
NEXT_PUBLIC_BRAND_LEGAL_NAME=Wolves Indumentaria
NEXT_PUBLIC_BRAND_SLUG=wolves
NEXT_PUBLIC_BRAND_DESCRIPTION=Ventas, stock, pedidos y atención de Wolves Indumentaria.
NEXT_PUBLIC_BRAND_LOGO=/brand/wolves-light.png
NEXT_PUBLIC_BRAND_LOGO_ON_DARK=/brand/wolves-dark.png
NEXT_PUBLIC_BRAND_FAVICON=/brand/wolves-favicon.png
NEXT_PUBLIC_BRAND_COLOR_NAVY="#111111"
NEXT_PUBLIC_BRAND_COLOR_NAVY_DEEP="#0a0a0a"
NEXT_PUBLIC_BRAND_COLOR_BLUE="#3a3a3a"
NEXT_PUBLIC_BRAND_COLOR_BLUE_HOVER="#1f1f1f"
NEXT_PUBLIC_BRAND_COLOR_PAPER="#efefef"
NEXT_PUBLIC_BRAND_COLOR_BLUE_DARK="#d4d4d4"
NEXT_PUBLIC_BRAND_COLOR_BLUE_HOVER_DARK="#e5e5e5"
NEXT_PUBLIC_BRAND_COLOR_PAPER_DARK="#ffffff2e"
