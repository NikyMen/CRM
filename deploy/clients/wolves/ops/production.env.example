# Wolves en https://wolves.consultoriadigital.io. Plantilla: nunca versionar valores reales.
# VPS compartido 72.60.15.125 (alias ssh `farmacia`): puertos, procesos, usuario y base propios.
#   backend 172.18.0.1:3820 · frontend 172.18.0.1:3821 · PostgreSQL 127.0.0.1:55433 · Redis 127.0.0.1:56380

# ─── Docker Compose (/var/www/crm-wolves/.env, root 0600) ─────────
POSTGRES_USER=wolves_user
POSTGRES_PASSWORD=generar-un-secreto-url-safe
POSTGRES_DB=wolves_db
POSTGRES_HOST_PORT=55433
REDIS_HOST_PORT=56380
REDIS_PASSWORD=generar-un-secreto-url-safe

# ─── Backend (/var/www/crm-wolves/backend/.env, wolves 0600) ──────
DATABASE_URL=postgresql://wolves_user:secreto@127.0.0.1:55433/wolves_db
DIRECT_URL=postgresql://wolves_user:secreto@127.0.0.1:55433/wolves_db
REDIS_URL=redis://:secreto-url-safe@127.0.0.1:56380
JWT_SECRET=generar-al-menos-48-bytes-al-azar
NODE_ENV=production
# 172.18.0.1 es el gateway de la red de Traefik: Traefik llega, Internet no.
PORT=3820
HOST=172.18.0.1
# CORS compara el origen exacto: sin barra final.
FRONTEND_URL=https://wolves.consultoriadigital.io
GLOBAL_RATE_LIMIT_MAX=1500
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_LEGACY_CHANNELS=false
UPLOAD_MAX_BYTES=10485760
CLIENT_DOCUMENTS_DIR=.data/client-documents
WHATSAPP_AUTH_DIR=.data/whatsapp-auth
WHATSAPP_MEDIA_DIR=.data/whatsapp-media
# No incluir las META_* vacías: frenan el arranque.
# Más la sección de backend de deploy/clients/wolves/brand.env (colores entre comillas).

# ─── Frontend (/var/www/crm-wolves/frontend/.env, se fija en next build) ───
NEXT_PUBLIC_API_URL=https://wolves.consultoriadigital.io/api/v1
ENABLE_LEGACY_CHANNELS=false
# Más la sección de frontend de deploy/clients/wolves/brand.env (colores entre comillas).
